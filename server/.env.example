# Server Configuration
PORT=4000
NODE_ENV=development

# CORS / Allowed Frontend Origin
CLIENT_ORIGIN=http://localhost:5173

# Database — Neon PostgreSQL (https://neon.tech)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication Secret (Standard single token)
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Media Storage (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=lost-and-found

# SMTP Configuration (e.g. Gmail App Password for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="Lost & Found <your_email@gmail.com>"

